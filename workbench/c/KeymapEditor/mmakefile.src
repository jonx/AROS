# KeymapEditor -- a small visual keymap editor (Intuition window). Built like
# LoadKeymap: a -noposixc main() command so it loads reliably on the hosted
# darwin-aarch64 port. intuition/graphics/keymap are opened at runtime.

include $(SRCDIR)/config/aros.cfg

FILES   := keymapeditor

EXEDIR  := $(AROS_C)

USER_CFLAGS := -noposixc

#MM- workbench-c : workbench-c-keymapeditor
#MM workbench-c-keymapeditor : includes linklibs

%build_prog mmake=workbench-c-keymapeditor \
    progname=KeymapEditor targetdir=$(EXEDIR) \
    files="$(FILES)"

%common
