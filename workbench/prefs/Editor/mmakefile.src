#
# Makefile to make JanoEditor Prefs Program.

include $(SRCDIR)/config/aros.cfg

FILES := JanoPrefs PrefsPort Prefs Prefs_Strings SampleEd Utils

EXEDIR := $(AROS_PREFS)

USER_CFLAGS := -DJANOPREF
USER_INCLUDES := -I$(SRCDIR)/$(CURDIR)/../../tools/Edit -I$(TOP)/$(CURDIR)/

#MM- workbench-prefs : workbench-prefs-editor
# The Editor prefs sources (Utils.c, JanoPrefs.c, Prefs_Strings.c) #include
# "../../tools/Edit/strings.h", which is GENERATED by FlexCat as part of the
# workbench-tools-editor-catalogs metatarget (its build_catalogs source=).
# Depend on it so that header exists before this program is compiled.
#MM workbench-prefs-editor : includes linklibs workbench-prefs-editor-catalogs workbench-tools-editor-catalogs

Prefs.c : ../../tools/Edit/Prefs.c
	@$(CP) $< $@

%build_prog mmake=workbench-prefs-editor \
    progname=Editor targetdir=$(EXEDIR) \
    files=$(FILES)
    

%common

