# Makefile to build AHI.

include $(SRCDIR)/config/aros.cfg

#MM- AHI : workbench-devs-AHI
#MM- AHI-quick : workbench-devs-AHI-quick

#MM- workbench-devs-AHI : workbench-devs-AHI-subsystem AHI-drivers
#MM- workbench-devs-AHI-quick : workbench-devs-AHI-subsystem-quick AHI-drivers-quick

#MM- AHI-raspi-armhf :  kernel-dma-bcm2708-includes
#MM- AHI-raspi-arm :  kernel-dma-bcm2708-includes

#MM- AHI-standalone-prereqs : \
#MM                         AHI-$(AROS_TARGET_ARCH)-$(AROS_TARGET_CPU)

#MM- AHI-emulation-prereqs : \
#MM                         AHI-alsa-bridge-$(AROS_TARGET_ARCH) \
#MM                         AHI-pulseaudio-bridge-$(AROS_TARGET_ARCH) \
#MM                         AHI-WASAPI-bridge-$(AROS_TARGET_ARCH) \
#MM                         AHI-coreaudio-bridge-$(AROS_TARGET_ARCH)

#MM workbench-devs-AHI-subsystem : includes \
#MM                         linklibs \
#MM                         AHI-$(FLAVOUR)-prereqs \
#MM                         workbench-libs-muimaster-includes

EXEDIR := $(AROSDIR)

NOWARN_FLAGS := $(NOWARN_POINTER_SIGN)
USER_CPPFLAGS := $(NOWARN_FLAGS)
AHI_OPTIONS=--with-os-includedir=$(AROS_INCLUDES)

# AHI's configure script will not set the needed preprocessor
# flags if cppflags is already defined, so we pass them using
# the configure option.
#
# AHI is an autotools subsystem: %build_with_configure feeds it USER_CFLAGS /
# USER_LDFLAGS via the configure environment (its Makefiles use @CFLAGS@ /
# @LDFLAGS@), but NOT the tree-wide LDFLAGS/make.cfg flags. So the two aarch64
# host-port build requirements have to be re-stated here or every AHI link
# breaks the same way a stale-object module would:
#   -Wl,--allow-multiple-definition : clang emits the weak __aros_libreq_<base>
#     version marker as a non-weak block-scope static, so it collides across a
#     module's objects (see config/make.cfg.in). Without this every AHI binary
#     (ahi.device, coreaudio.audio, AddAudioModes, AHI_MUI) fails to link with
#     "duplicate symbol __aros_libreq_SysBase".
#   -ffixed-x18 : x18 is the Darwin platform register; AROS-hosted preempts via
#     signals that clobber it, so a value left live in x18 is lost. AHI's
#     configure predates the flag being in make.cfg.
USER_CFLAGS := $(CFLAGS_NO_BUILTIN_FLOOR) -ffixed-x18
USER_LDFLAGS := -Wl,--allow-multiple-definition
AHI_OPTIONS+=--with-target-cppflags="$(TARGET_CPPFLAGS)"

#
# AHI uses GAS syntax, which LLVM AS
# doesnt understand, so use clang with the 
# configure'd AFLAGS to use the system AS.
#
TARGET_AS:=$(strip $(CC) $(TARGET_SYSROOT))
AHI_OPTIONS+=--with-target-asflags="$(AFLAGS)"

#
# AHI configure runs AC_CHECK_TOOL for objcopy/strip and falls back to
# ":" / bare names when the toolchain prefix doesn't match. Force the
# values so the per-driver MODEFILE binaries (RPiPWM/RPiHDMI etc.)
# get produced by llvm-objcopy.
#
%build_with_configure mmake=workbench-devs-AHI-subsystem prefix=$(EXEDIR) \
    extraoptions="$(AHI_OPTIONS)" usecppflags=no gnuflags=no \
    config_env_extra="OBJCOPY=$(OBJCOPY) STRIP=$(STRIP_PLAIN)"
