include $(SRCDIR)/config/aros.cfg

FILES := \
    AddBuffers \
    Automount \
    Avail \
    Break \
    ChangeTaskPri \
    CheckMem \
    ConClip \
    CopyToPAR \
    Date \
    Delete \
    DevList \
    DiskChange \
    Eject \
    Filenote \
    IconX \
    Info \
    Install \
    Join \
    LeakWatch \
    LibList \
    List \
    Load \
    Lock \
    MakeDir \
    MakeLink \
    Mount \
    Protect \
    Reboot \
    Relabel \
    Rename \
    RequestChoice \
    RequestFile \
    ResList \
    Search \
    SetClock \
    SetDate \
    SetDefaultFont \
    SetLocale \
    SetPSM \
    Shutdown \
    Sort \
    StackSnoop \
    SymbolDump \
    TaskList \
    Touch \
    Type \
    UUIDGen \
    Version \
    Wait \
    WaitForPort \
    Which

FILESSHRD := \
    Eval

DTFILE := \
    AddDataTypes

# Files that use AROS_SHx() instead of main()
SH_FILES := \
    AROSMonDrvs \
    Assign \
    Beep \
    BindDrivers \
    Copy \
    Debug \
    Dir \
    GfxControl \
    LoadWB \
    Play \
    Print \
    SetKeyboard \
    WaitX

USER_INCLUDES    := -I$(OBJDIR)
USER_CPPFLAGS    := -DADATE="\"$(shell date "+%d.%m.%Y")\""
USER_CFLAGS      := -noposixc

#MM- workbench : workbench-c
#MM- workbench-quick : workbench-c-quick

#MM workbench-c : \
#MM        workbench-c-$(AROS_TARGET_ARCH) \
#MM        workbench-c-$(AROS_TARGET_CPU) \
#MM        workbench-c-$(AROS_TARGET_ARCH)-$(AROS_TARGET_CPU)

#MM workbench-c-quick : \
#MM        workbench-c-$(AROS_TARGET_ARCH)-quick \
#MM        workbench-c-$(AROS_TARGET_CPU)-quick \
#MM        workbench-c-$(AROS_TARGET_ARCH)-$(AROS_TARGET_CPU)-quick

#MM workbench-c : \
#MM        includes \
#MM        kernel-task-includes \
#MM        linklibs \
#MM        workbench-c-adddatatypes \
#MM        workbench-c-sh \
#MM        workbench-c-requeststring \
#MM        workbench-c-eval \
#MM        workbench-libs-uuid

#MM workbench-c-quick : \
#MM        workbench-c-adddatatypes-quick \
#MM        workbench-c-sh-quick \
#MM        workbench-c-requeststring-quick \
#MM        workbench-c-eval-quick

$(OBJDIR)/evalParser.tab.c : evalParser.y
	@$(ECHO) Generating $(notdir $@) from $<...
	@$(BISON) -o $@ $<

USER_LDFLAGS     :=

%build_prog mmake=workbench-c-eval progname=Eval \
    files="Eval" targetdir=$(AROS_C) coverageinstr=no

$(workbench-c-eval_DEPS) : $(OBJDIR)/evalParser.tab.c

# We compile the core C: programs statically, for two reasons:
#   * The amiga-m68k boot floppy doesn't have space for stdc.library
#   * This gives us some possibility of system recovery if LIBS:
#     is deleted or badly Assign(ed).
USER_LDFLAGS     := -static

%build_prog mmake=workbench-c-requeststring progname=RequestString \
    files=RequestString targetdir=$(AROS_C) coverageinstr=no

# Standalone targets for OS-introspection commands, so bring-up images can
# build/deploy the small diagnostics without pulling the whole C: command set.
%build_prog mmake=workbench-c-version progname=Version \
    files=Version targetdir=$(AROS_C) coverageinstr=no

%build_prog mmake=workbench-c-avail progname=Avail \
    files=Avail targetdir=$(AROS_C) coverageinstr=no

%build_prog mmake=workbench-c-info progname=Info \
    files=Info targetdir=$(AROS_C) coverageinstr=no

%build_prog mmake=workbench-c-which progname=Which \
    files=Which targetdir=$(AROS_C) coverageinstr=no

%build_prog mmake=workbench-c-date progname=Date \
    files=Date targetdir=$(AROS_C) coverageinstr=no

# Headless screenshot tool: dump the front screen to a PPM (for inspection/
# recording/testing of the AROS display, headless or in a window).
%build_prog mmake=workbench-c-grabscreen progname=GrabScreen \
    files=GrabScreen targetdir=$(AROS_C) coverageinstr=no

# Library load-tester: OpenLibrary() a named lib and report OK/version or FAIL
# (distinguishes "file present" from "init/deps failed", unlike Version).
%build_prog mmake=workbench-c-testlib progname=TestLib \
    files=TestLib targetdir=$(AROS_C) coverageinstr=no

# Native oracle for the emu68k OpenCatalogA object/tag bridge.
%build_prog mmake=workbench-c-catalogprobe progname=CatalogProbe \
    files=CatalogProbe targetdir=$(AROS_C) uselibs="locale" coverageinstr=no

# Native control for the hosted screen + GadTools bevel-box sequence, so the
# same drawing can be run with no 68k program in front of it.
%build_prog mmake=workbench-c-bevelprobe progname=BevelProbe \
    files=BevelProbe targetdir=$(AROS_C) uselibs="gadtools" coverageinstr=no

# Native oracle for the emu68k GetPrefs structure crossing.
%build_prog mmake=workbench-c-prefsprobe progname=PrefsProbe \
    files=PrefsProbe targetdir=$(AROS_C) coverageinstr=no

# Batch loader smoke test for the desktop bring-up chain.
%build_prog mmake=workbench-c-loadmatrix progname=LoadMatrix \
    files=LoadMatrix targetdir=$(AROS_C) coverageinstr=no

# Direct ahi.device/CoreAudio playback smoke test. This avoids sound datatypes
# and file-backed samples so the audio path can be validated during port bring-up.
%build_prog mmake=workbench-c-ahismoke progname=AHISmoke \
    files=AHISmoke targetdir=$(AROS_C) coverageinstr=no

%build_progs mmake=workbench-c \
    files="$(FILES)" targetdir=$(AROS_C) \
    uselibs="uuid debug" coverageinstr=no

# Same core C: command programs, but as a standalone batch that does not pull in
# optional subdirectories. Useful for hosted bring-up when we want the basic CLI
# command set without also rebuilding larger GUI helpers.
%build_progs mmake=workbench-c-tools \
    files="$(FILES)" targetdir=$(AROS_C) \
    uselibs="uuid debug" coverageinstr=no

%build_progs mmake=workbench-c-sh \
    files=$(SH_FILES) targetdir=$(AROS_C) \
    usestartup=no

#MM workbench-c-logger : kernel-log-includes

%build_prog mmake=workbench-c-logger progname=Logger \
    files=Logger targetdir=$(AROS_C) coverageinstr=no usestartup=no

ifneq ($(AROS_TARGET_CPU),m68k)
    USER_CFLAGS += -DTARGETCPU="\"$(AROS_TARGET_CPU)\""
endif

%build_prog mmake=workbench-c-adddatatypes progname=AddDataTypes \
    files="$(DTFILE)" targetdir=$(AROS_C) coverageinstr=no

%common
