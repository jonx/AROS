#
#   Generate emu68k.library -- the 68k execution service binding: DOS's launch
#   router hands 68k hunk programs here; the library drives the host engine
#   (libemu68k.dylib) via hostlib.resource in scheduler-friendly quanta.
#

include $(SRCDIR)/config/aros.cfg

#MM- workbench-darwin-$(CPU) : hostlibs-emu68k
#MM hostlibs-emu68k : \
#MM     kernel-exec-includes \
#MM     includes-copy
#MM- hostlibs-emu68k : linklibs

USER_INCLUDES += -isystem $(GENINCDIR)

%build_module mmake=hostlibs-emu68k \
    modname=emu68k modtype=library \
    files="emu68k_init emu68k_runseg emu68k_oscall \
           emu68k_gen_dos emu68k_gen_exec emu68k_gen_utility \
           emu68k_gen_intuition emu68k_gen_graphics emu68k_gen_layers \
           emu68k_gen_gadtools emu68k_gen_asl emu68k_gen_icon \
           emu68k_gen_iffparse emu68k_gen_commodities emu68k_gen_diskfont \
           emu68k_gen_locale emu68k_gen_keymap emu68k_gen_datatypes \
           emu68k_gen_expansion emu68k_gen_cybergraphics emu68k_gen_mathffp \
           emu68k_gen_mathieeesingbas emu68k_gen_mathieeedoubbas"

%common
