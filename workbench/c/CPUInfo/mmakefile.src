include $(SRCDIR)/config/aros.cfg

FILES	:= main

x86FILES := x86 \
            x86_AMD \
            x86_Cyrix \
            x86_Intel \
            x86_NatSemi \
            x86_RiSE

# The legacy CPUID probe is x86-only. Every other target builds the portable
# processor.resource backend (cpuinfo_arch.c) instead.
ifeq ($(AROS_TARGET_CPU),i386)
ARCHFILES := $(x86FILES)
else ifeq ($(AROS_TARGET_CPU),x86_64)
ARCHFILES := $(x86FILES)
else
ARCHFILES := cpuinfo_arch
endif

EXEDIR  := $(AROS_C)

# Match the other C: commands: link against the AROS C runtime without the
# posixc startup, so the command needs only dos.library at runtime (it uses
# dos.library output, not stdio) and runs in a minimal boot.
USER_CFLAGS := -noposixc

#MM workbench-c-cpuinfo : includes linklibs

%build_prog mmake=workbench-c-cpuinfo \
    progname=CPUInfo targetdir=$(EXEDIR) \
    files="$(FILES) $(ARCHFILES)"

%common
