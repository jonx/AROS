#
#

include $(SRCDIR)/config/aros.cfg

ZOPFLILIB_SRC = \
			blocksplitter \
			cache \
			deflate \
			gzip_container \
			hash \
			katajainen \
			lz77 \
			squeeze \
			tree \
			util \
			zlib_container \
			zopfli_lib

USER_LDFLAGS := 

%build_linklib mmake=linklibs-zopfli \
    libname=zopfli files="$(ZOPFLILIB_SRC)"

# NOTE (aarch64-darwin-graft): removed a stray duplicate `workbench-c-cpuinfo`
# build_prog — a copy-paste from workbench/c/CPUInfo that built zopfli_bin as
# "CPUInfo" with an undefined EXEDIR here (linked to /CPUInfo and failed). The real
# CPUInfo command is workbench/c/CPUInfo; zopfli_bin is the host compressor built by
# the `host-zopfli` target below. This unblocks `make workbench-c-cpuinfo`.

%build_linklib mmake=host-linklibs-zopfli \
    libname=zopfli files="$(ZOPFLILIB_SRC)" compiler=host \
    cflags=$(HOST_CFLAGS) objdir="$(HOSTGENDIR)/$(CURDIR)/lib" \
    libdir="$(CROSSTOOLSDIR)/lib"

HOST_LDFLAGS += -L$(CROSSTOOLSDIR)/lib -lzopfli -lm

%build_prog mmake=host-zopfli \
    progname=zopfli targetdir=$(TOOLDIR) \
    objdir="$(HOSTGENDIR)/$(CURDIR)" files="zopfli_bin" compiler=host

#MM host-zopfli : host-linklibs-zopfli
