# KeymapWatch -- background task that re-applies ENVARC:Keymap when the host
# changes it (live keymap switching from the Mac side). -noposixc main().

include $(SRCDIR)/config/aros.cfg

FILES   := keymapwatch

EXEDIR  := $(AROS_C)

USER_CFLAGS := -noposixc

#MM- workbench-c : workbench-c-keymapwatch
#MM workbench-c-keymapwatch : includes linklibs

# detach=yes: KeymapWatch loops forever; without detach.o the Run'd CLI child
# keeps the boot console referenced, so the boot console window never closes
# after EndCLI and sits in front of the Wanderer desktop.
%build_prog mmake=workbench-c-keymapwatch \
    progname=KeymapWatch targetdir=$(EXEDIR) \
    files="$(FILES)" detach=yes

%common
